i, j = map(int, input().split())


start = min(i, j)
end = max(i, j)

max_cycle_length = 0

for n in range(start, end + 1):
    current = n
    cycle_length = 1
    
    
    while current != 1:
        if current % 2 == 0:
            current = current // 2
        else:
            current = 3 * current + 1
        cycle_length += 1
        
    
    if cycle_length > max_cycle_length:
        max_cycle_length = cycle_length


print(f"{i} {j} {max_cycle_length}")
