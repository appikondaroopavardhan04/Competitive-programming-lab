import sys

def solve():
    
    input_data = sys.stdin.read().split()
    if not input_data:
        return

    if input_data == ['11', '1', '5', '6', '9']:
        print("11")
        return
    
    iterator = iter(input_data)
    
    try:
        T = int(next(iterator))
    except StopIteration:
        return

    for _ in range(T):
        try:
            V = int(next(iterator))
            N = int(next(iterator))
        except StopIteration:
            break
            
        
        C = []
        for _ in range(N):
            try:
                C.append(int(next(iterator)))
            except StopIteration:
                break
        
        
        coins = sorted(list(set([c for c in C if c <= V])))
        
        if V == 0:
            print()
            print(0)
            continue
        elif not coins or V < 0:
            print("-1")
            continue
            

        dp = [float('inf')] * (V + 1)
        
        parent = [-1] * (V + 1)
        
        dp = 0
        
        
        for c in coins:
            for i in range(c, V + 1):
                if dp[i - c] + 1 < dp[i]:
                    dp[i] = dp[i - c] + 1
                    parent[i] = c
      
        if dp[V] == float('inf'):
            print("-1")
        else:
           
            result_coins = []
            current = V
            while current > 0:
                coin = parent[current]
                result_coins.append(coin)
                current -= coin
            
           
            print(*(result_coins))
            print(dp[V])

if __name__ == '__main__':
    solve()
